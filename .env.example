# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — copy to `.env.local` and fill in. NEVER commit real values.
# In Netlify, these are set per deploy context (production / deploy-preview / branch)
# by the Supabase Netlify integration. In CI, secrets live in GitHub Actions secrets.
# ─────────────────────────────────────────────────────────────────────────────

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# --- Server-only (NEVER prefix with NEXT_PUBLIC_, never import in client components) ---
# Used only by trusted server code / CI migrations. Keep out of Claude's reach.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Project refs used by hooks + scripts to tell dev from prod ---
# The no-direct-prod-db hook blocks AI writes whose ref == SUPABASE_PROD_REF.
SUPABASE_DEV_REF="your-dev-project-ref"
SUPABASE_PROD_REF="your-prod-project-ref"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
