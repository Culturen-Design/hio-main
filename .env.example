# ─────────────────────────────────────────────────────────────────────────────
# Env template. In this MONOREPO, copy these into the app you're running:
#   apps/self-serve/.env.local   and/or   apps/studio/.env.local   (both gitignored)
# Local dev points at the DEV Supabase project (current account). PROD lives in a
# SEPARATE account — its values are set in Netlify (production context) + GitHub
# Actions secrets, never here. See docs/ENVIRONMENTS.md.
# ─────────────────────────────────────────────────────────────────────────────

# --- Public (safe to expose to the browser) ---  [dev project]
NEXT_PUBLIC_SUPABASE_URL="https://yfvqmzaqhayveqllchuh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."   # publishable key from the dev project

# --- Server-only (NEVER prefix with NEXT_PUBLIC_, never import in client components) ---
# Used only by trusted server code / CI migrations. Keep out of Claude's reach.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Project refs used by hooks + scripts to tell dev from prod ---
# The no-direct-prod-db hook blocks AI writes whose ref == SUPABASE_PROD_REF.
SUPABASE_DEV_REF="yfvqmzaqhayveqllchuh"          # dev = Hio project (current account)
SUPABASE_PROD_REF="your-prod-project-ref"        # prod = created in the SEPARATE account

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
