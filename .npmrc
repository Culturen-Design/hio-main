# @culturen-design/* packages (design tokens) live on GitHub Packages, which
# always requires auth — even for reads. Everyone (local dev, CI, Netlify)
# provides NODE_AUTH_TOKEN:
#   local:   a classic PAT with read:packages, e.g. setx NODE_AUTH_TOKEN ghp_xxx
#   CI:      set in the workflow step env (see .github/workflows/ci.yml)
#   Netlify: add NODE_AUTH_TOKEN in Site settings → Environment variables
@culturen-design:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
