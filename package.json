{
  "name": "hio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.4.0",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "biome format --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > packages/db/src/database.types.ts",
    "plugin:build": "node scripts/build-plugin.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
