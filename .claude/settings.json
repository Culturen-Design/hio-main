{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run :*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(git push origin:*)",
      "Bash(gh pr :*)",
      "Bash(gh pr create:*)",
      "Bash(supabase migration new:*)",
      "Bash(supabase db diff:*)",
      "Bash(supabase db lint:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(supabase status)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push:* main*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  },
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "SUPABASE_DEV_REF": "yfvqmzaqhayveqllchuh",
    "SUPABASE_PROD_REF": "ltrigisoniqcsuamaebj"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/block-secrets.mjs" }]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/protect-paths.mjs" }]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/no-direct-prod-db.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/format-and-check.mjs" }]
      }
    ]
  }
}
